.env
assistant/assistant
__pycache__/
.pytest_cache/
*.pyc
scripts/prototype-run/.run/

# Local SQLite database when running the assistant outside Compose.
assistant/data/

# Authenticated SQLite backups downloaded with `make backup`. They contain the
# secrets table, so they are never committed.
backups/

# Recorded voice takes live in the training work dir (~/.cache/clanka/...), never
# in the checkout. This guard catches someone pointing record.py at a relative
# path: the only WAVs git tracks are the synthesized detection fixtures.
wakeword/training/real/
wakeword/training/**/*.wav
!wakeword/tests/fixtures/*.wav

# Try-out wake detectors for this machine. The wakeword service copies them
# in at container start. Ignoring them keeps auto-deploy from seeing a dirty
# checkout (deploy-watch leaves a dirty tree alone).
wakeword/models/local/*
!wakeword/models/local/.gitkeep

# Wake-phrase sample bundles exported from the Dashboard. They contain the
# owner's voice and are copied off the Pi by hand, never committed.
/exports/

# Owner-voice STT replay clips. Checked-in fixtures are synthetic PCM.
stt/fixtures/private/*
!stt/fixtures/private/.gitkeep

# Private Pi and tailnet details for agents; never committed.
docs/agents/machines.md

# Local agent skills, kept per machine and never committed.
/.agents/skills/
/.claude/skills/
/.cursor/skills/
/.opencode/skills/
