# Copy to .env and adjust. Non-secret assistant settings live in
# assistant/config.yaml; this file holds deployment inputs only.
#
# GIT_SHA is not set here: scripts/deploy.sh and the Makefile derive it from
# git so image tags match the commit. Compose falls back to "dev" when you run
# `docker compose up` directly.
ASSISTANT_HTTP_PORT=8080
ASSISTANT_DEBUG_PORT=8081
# Dashboard: loopback-only port, exposed to the tailnet by `tailscale serve`.
# Leave the owner empty to disable it, or set it to your Tailscale login.
ASSISTANT_DASHBOARD_PORT=8082
ASSISTANT_DASHBOARD_OWNER=
# Exact Host header(s) tailscale serve uses, comma-separated:
# ASSISTANT_DASHBOARD_HOSTS=pi.example.ts.net
# Override to try another sentence model (e.g. BAAI/bge-small-en-v1.5).
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
TZ=America/New_York

# Host user that owns the Pulse socket and cookie. The assistant container runs
# as this user so audio playback can authenticate with the host's Pulse server.
ASSISTANT_UID=1000
ASSISTANT_GID=1000

# Named Pulse sink for replies (pactl list short sinks). Empty uses the default.
ASSISTANT_PULSE_SINK=

# Spotify. Connect pairing (Soloist) and Web API auth are separate grants.
# Create an app in the Spotify Developer Dashboard, add the exact redirect URI
# below to its Redirect URIs allowlist, and keep it in development mode (the
# app owner needs Premium; development mode allows five users). The client ID
# is public and there is no client secret: the flow uses PKCE. The refresh
# token is stored only in the write-only secrets table.
SPOTIFY_CLIENT_ID=
SPOTIFY_REDIRECT_URI=https://<pi-name>.<tailnet>.ts.net/spotify/callback
# The Connect device name; the assistant page and the Soloist receiver use
# this value.
SPOTIFY_DEVICE_NAME=Clanka
# Soloist uses host networking and advertises over mDNS itself. The container
# hostname is kept distinct from the Pi's own .local name.
SPOTIFY_MDNS_HOSTNAME=clanka
# Initial receiver volume on a brand-new data directory (0-100). Later volume
# changes are persisted in Soloist's private data directory.
SPOTIFY_INITIAL_VOLUME=50
# Bound the receiver's download cache in MB (Soloist minimum 100). Credentials
# are separate and tiny.
SPOTIFY_CACHE_MB=2048
# Soloist inherits ASSISTANT_PULSE_SINK so music and speech share one output.
# Loopback-only control socket the status heartbeat asks for login state.
SPOTIFY_WS_ADDR=127.0.0.1:24880
# Case-insensitive substring of the receiver's Pulse application name. Soloist
# reports "spotify"; this only selects the stream that ducking lowers.
SPOTIFY_STREAM_MATCH=spotify
# Private state directory. scripts/soloist-setup.sh creates it (mode 0700) and
# downloads the official binary there; never commit or copy the binary or key.
# SOLOIST_DIR=~/.cache/clanka/soloist

# Named Pulse source for the microphone (pactl list short sources). Empty uses
# the host default. The assistant container is the only one that opens audio.
ASSISTANT_PULSE_SOURCE=

# openWakeWord models and thresholds. The list is the Assistant's explicit
# allowlist: a detection from a model that is not listed never starts a turn.
# clanker is the detector trained for this house and baked into the wakeword
# image (see wakeword/training/README.md); okay_nabu, hey_jarvis and hey_rhasspy
# still ship upstream and stay selectable by name. Extra models add false wakes;
# the default stays the one trained word. The old WAKEWORD_MODEL=single_value
# form is still accepted.
WAKEWORD_MODELS=clanker
# Default detection probability for every model without an override. Higher is
# stricter. The Assistant sends this with every detect stream, so it is the
# real knob rather than the service's fallback --threshold.
WAKEWORD_THRESHOLD=0.5
# Optional per-model overrides, name:value comma-separated. Every name must be
# in WAKEWORD_MODELS or the command list below. Example for two models:
# WAKEWORD_MODELS=clanker,okay_nabu
# WAKEWORD_THRESHOLDS=clanker:0.6,okay_nabu:0.5
WAKEWORD_THRESHOLDS=

# Wake-free commands (#81): off by default until volume_up/volume_down models
# trained on this house's samples exist and the false-trigger measurement is
# done. When enabled, the Assistant asks wakeword for these models and handles
# a detection with one volume step and a short Cue, with no STT. The .tflite
# files must be in wakeword/models/ before the image is built (see
# wakeword/training/README.md); a missing model is simply never detected.
WAKEWORD_COMMANDS_ENABLED=false
# WAKEWORD_COMMANDS=volume_up,volume_down
# WAKEWORD_COMMAND_STEP=10
# WAKEWORD_COMMAND_COOLDOWN=1.5s
# Command models default to 0.7, stricter than the wake word. Override per
# model through WAKEWORD_THRESHOLDS (volume_up:0.75,volume_down:0.75).

# Dashboard wake-phrase samples (/voice-samples). The dashboard writes finished
# bundles to ./exports (bind-mounted at /exports). These four values only build
# the copy line shown after Submit; leave them empty to hide it and use the
# Download button instead.
# ASSISTANT_VOICE_SAMPLES_HOST_DIR=/home/rbpi/clanka-bot/exports
# ASSISTANT_EXPORT_SSH_USER=rbpi
# ASSISTANT_EXPORT_SSH_HOST=pi
# ASSISTANT_EXPORT_DESKTOP=<desktop>

# Moonshine streaming models baked into the stt image, and the one to warm at
# startup. Changing these needs `docker compose build stt`, not a restart.
STT_MODELS=small-streaming,tiny-streaming
STT_MODEL=small-streaming
STT_LANGUAGE=en

# Pocket TTS service. The model weights and these voices are downloaded
# anonymously at image build time, so no Hugging Face token is needed and
# startup never touches the network. Changing either value needs a rebuild
# (`docker compose build tts`), not just a restart.
TTS_LANGUAGE=english
# Pi 5: english_18m_2026-10 with TTS_THREADS=1 passed local throughput tests.
# Thread changes need recreation; language changes also rebuild model weights.
TTS_THREADS=4
# Comma-separated voices to warm; the first one (or TTS_VOICE) is the default.
TTS_VOICES=alba
TTS_VOICE=alba
# Custom voice states live on the separate assistant-voices volume at
# ${ASSISTANT_DATA_DIR}/voices, mounted read-only into tts at /voices. These are
# the config.yaml defaults; uncomment only to point at a different volume path
# (for the assistant side and the path tts sees) or to change the speech-rate
# config layer.
# ASSISTANT_VOICE_DIR=voices
# ASSISTANT_VOICE_TTS_DIR=/voices
# ASSISTANT_VOICE_RATE=1.0

# Agent path model key (OpenRouter). Leave empty to keep the Fast path only;
# agent requests then answer with the configured Unavailable message.
OPENROUTER_API_KEY=

# Primary weather provider (weather.current). Optional: leave empty and the
# keyless Open-Meteo and wttr.in providers still answer. The same name can be
# stored from Dashboard > Secrets, where the stored value wins.
WEATHERAPI_API_KEY=

# GitHub Agent Tools (issue_create, pr_list, notifications). A fine-grained
# token scoped to the repositories in tools.github.allowed_repos needs
# "Issues: Read and write" for issue_create, and enough repository access for
# the review-requested pull-request search. The token is write-only and never
# appears in settings or logs.
GITHUB_TOKEN=
# OPTIONAL. GitHub's notifications API does not accept fine-grained tokens, so
# github.notifications uses only this separate classic personal access token
# with just the "notifications" scope. It is never used for issues or PR
# search, and GITHUB_TOKEN is never sent to the notifications endpoint. Leave it
# empty and github.notifications says a classic token is needed; issues and PRs
# keep working.
GITHUB_NOTIFICATIONS_TOKEN=

# Monster Smart Lighting (Duo+ monitor light bar and RGBIC lights). Use the
# same account as the Monster Smart Lighting app. Both are write-only secrets;
# these values are only the bootstrap, and the Secrets page wins.
MONSTER_EMAIL=
MONSTER_PASSWORD=

# ntfy Notifications. The topic is generated once on first use and stored in
# the write-only secrets table; set NTFY_TOPIC only to pin a topic yourself.
# NTFY_TOKEN is optional and must be a token the ntfy server issued (for
# example `ntfy token add` on a self-hosted server); a random local value is not
# accepted by ntfy. On the default public ntfy.sh, leaving the token empty
# publishes to the unguessable topic without an Authorization header.
NTFY_TOPIC=
NTFY_TOKEN=

# Internal SearXNG hashing key (not an authentication secret). The service is
# reachable only on the Compose network with the limiter off. Set this only if
# the host rotates application secrets; searxng/config/settings.yml carries the
# same non-secret default so a fresh checkout starts.
SEARXNG_SECRET=clanka-internal-search

