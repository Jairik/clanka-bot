# Build args the Pi's .env sets, for the arm64 images CI publishes
# (.github/workflows/images.yml). The Pi pulls an image only when its own
# checkout and .env produce the same key (scripts/image-keys.py), so keep these
# in step with the Pi: a value that differs makes the Pi build that one service
# locally instead of pulling it. Nothing here is secret; only build args matter.
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
STT_MODELS=small-streaming,tiny-streaming
TTS_LANGUAGE=english_18m_2026-10
TTS_VOICES=alba
TTS_VOICE=alba
TTS_CATALOGUE=all
