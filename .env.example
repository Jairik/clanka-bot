# Copy to .env and adjust. Non-secret assistant settings live in
# assistant/config.yaml; this file holds deployment inputs only.
#
# GIT_SHA is not set here: scripts/deploy.sh and the Makefile derive it from
# git so image tags match the commit. Compose falls back to "dev" when you run
# `docker compose up` directly.
ASSISTANT_HTTP_PORT=8080
ASSISTANT_DEBUG_PORT=8081
# Dashboard: loopback-only port, exposed to the tailnet by `tailscale serve`.
# Leave the owner empty to disable it, or set it to your Tailscale login.
ASSISTANT_DASHBOARD_PORT=8082
ASSISTANT_DASHBOARD_OWNER=
# Exact Host header(s) tailscale serve uses, comma-separated:
# ASSISTANT_DASHBOARD_HOSTS=pi.example.ts.net
# Override to try another sentence model (e.g. BAAI/bge-small-en-v1.5).
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
TZ=UTC

# Host user that owns the Pulse socket and cookie. The assistant container runs
# as this user so audio playback can authenticate with the host's Pulse server.
ASSISTANT_UID=1000
ASSISTANT_GID=1000

# Named Pulse sink for replies (pactl list short sinks). Empty uses the default.
ASSISTANT_PULSE_SINK=

# Spotify. Connect pairing (librespot) and Web API auth are separate grants.
# Create an app in the Spotify Developer Dashboard, add the exact redirect URI
# below to its Redirect URIs allowlist, and keep it in development mode (the
# app owner needs Premium; development mode allows five users). The client ID
# is public and there is no client secret: the flow uses PKCE. The refresh
# token is stored only in the write-only secrets table.
SPOTIFY_CLIENT_ID=
SPOTIFY_REDIRECT_URI=https://<pi-name>.<tailnet>.ts.net/spotify/callback
# The Connect device name; the assistant page and librespot use this value.
SPOTIFY_DEVICE_NAME=Clanka
# Spotify discovers the device over mDNS, so librespot uses host networking.
# The container runs a small Avahi responder restricted to the default-route
# interface. Set this to an interface NAME (for example wlan0 or eth0) when
# that guess is wrong; it is not an IP address. Empty auto-detects.
SPOTIFY_ZEROCONF_INTERFACE=
# The .local hostname Avahi publishes for the receiver. Keep it distinct from
# the host's own name.
SPOTIFY_MDNS_HOSTNAME=clanka
# The internal zeroconf server's advertised port. It must be reachable on the
# LAN; no Docker port mapping is used because the service is on the host net.
SPOTIFY_ZEROCONF_PORT=40899
SPOTIFY_BITRATE=320
SPOTIFY_INITIAL_VOLUME=50
# Bound the librespot audio cache on the Pi's disk. Credentials are separate
# and tiny.
SPOTIFY_CACHE_LIMIT=2G

# Named Pulse source for the microphone (pactl list short sources). Empty uses
# the host default. The assistant container is the only one that opens audio.
ASSISTANT_PULSE_SOURCE=

# openWakeWord model and threshold. The model must be one the wakeword service
# preloads, and the assistant's wakeword.model must match.
WAKEWORD_MODEL=okay_nabu
WAKEWORD_THRESHOLD=0.5

# Moonshine streaming models baked into the stt image, and the one to warm at
# startup. Changing these needs `docker compose build stt`, not a restart.
STT_MODELS=small-streaming,tiny-streaming
STT_MODEL=small-streaming
STT_LANGUAGE=en

# Pocket TTS service. The model weights and these voices are downloaded
# anonymously at image build time, so no Hugging Face token is needed and
# startup never touches the network. Changing either value needs a rebuild
# (`docker compose build tts`), not just a restart.
TTS_LANGUAGE=english
# Comma-separated voices to warm; the first one (or TTS_VOICE) is the default.
TTS_VOICES=alba
TTS_VOICE=alba
# Custom voice states live on the separate assistant-voices volume at
# ${ASSISTANT_DATA_DIR}/voices, mounted read-only into tts at /voices. These are
# the config.yaml defaults; uncomment only to point at a different volume path
# (for the assistant side and the path tts sees) or to change the speech-rate
# config layer.
# ASSISTANT_VOICE_DIR=voices
# ASSISTANT_VOICE_TTS_DIR=/voices
# ASSISTANT_VOICE_RATE=1.0

# Agent path model key (OpenRouter). Leave empty to keep the Fast path only;
# agent requests then answer with the configured Unavailable message.
OPENROUTER_API_KEY=

# GitHub Agent Tools (issue_create, pr_list, notifications). A fine-grained
# token scoped to the repositories in tools.github.allowed_repos needs
# "Issues: Read and write" for issue_create, and enough repository access for
# the review-requested pull-request search. Notifications are the exception:
# GitHub's notifications API only accepts a classic token with the
# notifications (or repo) scope, so a fine-grained token makes
# github.notifications fail with that contract note. The token is write-only
# and never appears in settings or logs.
GITHUB_TOKEN=

# ntfy Notifications. The topic is generated once on first use and stored in
# the write-only secrets table; set NTFY_TOPIC only to pin a topic yourself.
# NTFY_TOKEN is optional and must be a token the ntfy server issued (for
# example `ntfy token add` on a self-hosted server); a random local value is not
# accepted by ntfy. On the default public ntfy.sh, leaving the token empty
# publishes to the unguessable topic without an Authorization header.
NTFY_TOPIC=
NTFY_TOKEN=

# Internal SearXNG hashing key (not an authentication secret). The service is
# reachable only on the Compose network with the limiter off. Set this only if
# the host rotates application secrets; searxng/config/settings.yml carries the
# same non-secret default so a fresh checkout starts.
SEARXNG_SECRET=clanka-internal-search

